{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "TimerSchedule": "0 0 */6 * * *",
    "PackageCache__GalleryEndpoint": "https://www.powershellgallery.com/api/v2/Search()",
    "PackageCache__PageSize": "100",
    "PackageCache__OverlapMinutes": "5",
    "PackageCache__InitialLookBackHours": "87600",
    "PackageCache__FullSyncFromUtc": "",
    "PackageCache__MaxSyncDurationMinutes": "0",
    "PackageCache__MaxRetries": "4",
    "PackageCache__RetryBaseDelayMilliseconds": "1000",
    "PackageCache__StorageMode": "FileSystem",
    "PackageCache__OutputDirectory": ".artifacts",
    "PackageCache__DatabaseName": "psgallery-cache.sqlite",
    "PackageCache__LatestBlobName": "latest/psgallery-cache.zip",
    "PackageCache__ManifestBlobName": "latest/psgallery-cache.manifest.json",
    "PackageCache__LockBlobName": "locks/psgallery-cache.lock",
    "PackageCache__RetainVersions": "10",
    "PackageCache__BlobConnectionString": "",
    "PackageCache__BlobContainerName": "",
    "PackageCache__BlobContainerUrl": "",
    "PackageCache__BlobBaseUrl": ""
  }
}